[Unit]
Description=تشغيل مسح الفجر يوميا قبل الدوام

[Timer]
# 🕕 السادسة والنصف بتوقيت الرياض — قبل أن يصل الفريق
# ⏰ **المنطقة صريحة** — ⚠️ **و`OnCalendar` بلا منطقة يتبع منطقة الخادم**،
# فمسح «الفجر» يقع الساعة ٩:٣٠ صباحا إن كان الخادم على UTC. **ووقت
# يقاس بمنطقة غير معلنة يزيح كل شيء بعده.**
OnCalendar=*-*-* 06:30:00 Asia/Riyadh
Persistent=true
AccuracySec=2min

[Install]
WantedBy=timers.target
